# Next.js API proxy target for the current Express service.
YATRASETU_BACKEND_URL=http://localhost:5000

# Browser requests use the same-origin Next.js route handlers.
NEXT_PUBLIC_BACKEND_API_URL=/api/v1

# Required for production authentication. Keep the publishable/anon key public;
# never expose SUPABASE_SERVICE_ROLE_KEY to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_MODE=production

# Backend-only Supabase values. Use the same project URL and publishable/anon key
# as above; never expose the service-role key to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL/Prisma. Prefer the pooled URL at runtime and direct URL for migrations.
DATABASE_URL=
DIRECT_URL=

# Production provider adapters
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=
WEATHER_API_KEY=
REDIS_URL=

# Deployment/runtime
FRONTEND_URL=http://localhost:3000
PORT=5000
