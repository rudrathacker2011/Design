# Next.js API proxy target for the current Express service.
YATRASETU_BACKEND_URL=http://localhost:5000

# Browser requests use the same-origin Next.js route handlers.
NEXT_PUBLIC_BACKEND_API_URL=/api/v1

# Required for production authentication. Keep the publishable/anon key public;
# never expose SUPABASE_SERVICE_ROLE_KEY to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_MODE=demo
