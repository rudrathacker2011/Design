{
  "name": "yatrasetu",
  "version": "1.0.0",
  "description": "YatraSetu — Adaptive, Trust-First AI Tourism Intelligence Platform",
  "private": true,
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n \"backend,next\" -c \"cyan,magenta\" \"npm run dev --workspace=backend\" \"next dev\"",
    "dev:web": "next dev",
    "build": "next build && npm run build --workspace=backend",
    "start": "next start",
    "install:all": "npm install",
    "db:push": "npm run db:push --workspace=backend",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:studio": "npm run db:studio --workspace=backend",
    "lint": "oxlint src",
    "test": "npm run build --workspace=backend && node --test tests/unit/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "concurrently": "^9.1.2",
    "oxlint": "^1.81.0",
    "typescript": "~5.7.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
